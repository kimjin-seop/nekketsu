{
 "date": "2026-11-22",
 "scales": [
  1,
  4
 ],
 "scale_rule": "1x 를 정수배 n 으로만 확대(image-rendering: pixelated). 4x 파일은 1x 의 NEAREST 확대본",
 "why_img": "/ui/ 는 루프백 전용(원격 403)이라 원작 파생이 아닌 이 에셋은 /img/ 아래",
 "version": "1.0",
 "scope": "M7 터치 패드 스킨(web/touch_pad.js·touch_pad.css 의 요소와 1:1)",
 "unit_rule": "1x 기준 u=16(A·B 지름). touch_pad.js place() 의 u(48~84 CSS px)를 16의 배수(48=3x, 64=4x, 80=5x)로 내려 맞추면 도트가 고르게 확대된다. 그대로 두면 비정수 확대(흐림 없이 pixelated 이나 픽셀 폭이 들쭉날쭉)",
 "map": {
  ".nktp-btn A(btn[C.A])": {
   "box": "u x u",
   "img": "btn_a_normal / .on = btn_a_pressed",
   "size_1x": [
    16,
    16
   ]
  },
  ".nktp-btn B": {
   "box": "u x u",
   "img": "btn_b_normal / .on = btn_b_pressed",
   "size_1x": [
    16,
    16
   ]
  },
  ".nktp-btn 점프": {
   "box": "0.84u (rr*2)",
   "img": "btn_jump_normal / .on = btn_jump_pressed",
   "size_1x": [
    14,
    14
   ],
   "note": "14/16=0.875u 로 맞추면 정수배"
  },
  ".nktp-btn.p ≡": {
   "box": "48 x 48 고정",
   "img": "btn_pause_normal / .on = btn_pause_pressed",
   "size_1x": [
    12,
    12
   ],
   "note": "48 = 정확히 4x"
  },
  ".nktp-ring": {
   "box": "2R = 1.56u",
   "img": "stick_ring_on (손가락 닿은 동안), .hint = stick_ring_idle",
   "size_1x": [
    25,
    25
   ],
   "note": "25/16=1.5625u"
  },
  ".nktp-knob": {
   "box": "round(0.9R) = 0.70u",
   "img": "stick_knob_normal / .edge = stick_knob_edge",
   "size_1x": [
    11,
    11
   ],
   "note": "11/16=0.6875u"
  }
 },
 "css_hint": "배경 그림으로: background:url(/img/touch/btn_a_normal_4x.png) 0 0/100% 100% no-repeat; image-rendering:pixelated; border:0; border-radius:0; 글자 포함 그림을 쓰면 color:transparent; text-shadow:none. 그림자·눌림 이동은 그림 안에 들어 있다(눌림 = 오른쪽 아래 1px(1x) 이동, 그림자 0). 4x 한 장을 크기만 바꿔 쓰면 3x·5x 도 NEAREST 축소/확대가 되므로 정확한 정수배가 필요하면 1x 를 쓰고 CSS 크기를 16n 으로",
 "alpha_note": "몸통은 의도된 반투명(전투 화면이 비쳐 보이게, 알파 60~160). 테두리·글자는 불투명",
 "load_hint": "터치 패드가 처음 켜질 때 normal·pressed 를 함께 프리로드(1x 합계 약 3KB)",
